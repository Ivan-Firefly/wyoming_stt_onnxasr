services:
  wyoming-stt-onnxasr:
    image: firefly27/wyoming-stt-onnxasr:latest
    container_name: wyoming-stt-onnxasr
    restart: unless-stopped
    ports:
      - "10305:10305"
    environment:
      # Select the model using its directory path only.
      # The path relative to /models is also used as the onnx-asr model ID.
      # Example: /models/gigaam-v3-ctc
      MODEL_PATH: /models/alphacep/vosk-model-small-streaming-ru
      # Use int8 on Raspberry Pi 4 as a starting point. Set to "" to omit this option.
      QUANTIZATION: ""
    volumes:
      # Writable: onnx-asr may download/cache model files here on first start.
      - ./models:/models
    command:
      - /bin/sh
      - -c
      - |
        set -eu
        case "$$MODEL_PATH" in
          /models/*) MODEL_NAME="$${MODEL_PATH#/models/}" ;;
          *) echo "ERROR: MODEL_PATH must be inside /models (mounted from ./models)" >&2; exit 2 ;;
        esac
        if [ -z "$$MODEL_NAME" ]; then
          echo "ERROR: MODEL_PATH must point to a model directory under /models" >&2
          exit 2
        fi
        mkdir -p "$$MODEL_PATH"
        set -- --model "$$MODEL_NAME" --model-dir "$$MODEL_PATH" --uri tcp://0.0.0.0:10305
        if [ -n "$${QUANTIZATION:-}" ]; then
          set -- "$$@" --quantization "$$QUANTIZATION"
        fi
        exec python -m wyoming_onnxasr "$$@"
