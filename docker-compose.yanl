services:
  wyoming-stt-onnxasr:
    image: firefly27/wyoming-stt-onnxasr:latest
    container_name: wyoming-stt-onnxasr
    restart: unless-stopped
    ports:
      - "10305:10305"
    environment:
      MODEL_NAME: alphacep/vosk-model-small-ru
      # Container path; ./models is mounted below at /models.
      MODEL_DIR: /models/model1
      # Set to "" to omit this option.
      QUANTIZATION: ""
    volumes:
      # Writable so onnx-asr can download/cache model files here on first start.
      - ./models:/models
    command:
      - /bin/sh
      - -c
      - |
        set -- --model "$$MODEL_NAME" --model-dir "$$MODEL_DIR" --uri tcp://0.0.0.0:10305
        if [ -n "$$QUANTIZATION" ]; then
          set -- "$$@" --quantization "$$QUANTIZATION"
        fi
        exec python -m wyoming_onnxasr "$$@"
